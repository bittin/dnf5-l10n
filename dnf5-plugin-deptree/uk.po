#: deptree.cpp:31
msgid "Display package dependency trees."
msgstr "Показати дерева залежностей пакунків."

#: deptree.cpp:35
msgid "Package names, NEVRAs, or glob patterns."
msgstr "Назви пакунків, NEVRA або шаблони glob."

#: deptree.cpp:45
msgid "Show packages requiring each package."
msgstr "Показати пакунки, які потребують кожного пакунка."

#: deptree.cpp:47
msgid "Print a sorted, deduplicated package list."
msgstr "Вивести відсортований список пакунків без повторів."

#: deptree.cpp:49
msgid "Show requirement capability nodes."
msgstr "Показати вузли можливостей-вимог."

#: deptree.cpp:52
msgid "Include all matching package versions."
msgstr "Включити всі відповідні версії пакунків."

#: deptree.cpp:54
msgid "Display dependency trees for installed packages only."
msgstr "Показати дерева залежностей лише для встановлених пакунків."

#: deptree.cpp:59
msgid ""
"Show only branches leading to packages with specified names. List option, "
"supports globs."
msgstr ""
"Показати лише гілки, що ведуть до пакунків із вказаними назвами. Параметр-"
"список, підтримує шаблони."

#: deptree.cpp:64
msgid "Limit to packages of the specified architectures."
msgstr "Обмежити пакунками вказаних архітектур."

#: deptree.cpp:78
msgid "Limit traversal to N dependency levels."
msgstr "Обмежити обхід N рівнями залежностей."

#: deptree.cpp:92
msgid ""
"Comma-separated dependency types: requires, recommends, suggests, "
"supplements, enhances."
msgstr ""
"Типи залежностей через кому: requires, recommends, suggests, supplements, "
"enhances."

#: deptree.cpp:125
#, c++-format
msgid "No match for argument \"{}\"."
msgstr "Немає відповідності для аргументу \"{}\"."

#: deptree_graph.cpp:422
#, c++-format
msgid "choice: {}"
msgstr "варіант: {}"

#: deptree_graph.cpp:424
#, c++-format
msgid "if {}:"
msgstr "якщо {}:"

#: deptree_graph.cpp:426
msgid "else:"
msgstr "інакше:"

#: deptree_graph.cpp:428
#, c++-format
msgid "requirement: {}"
msgstr "вимога: {}"

#: deptree_graph.cpp:430
#, c++-format
msgid "unsatisfied: {}"
msgstr "незадоволено: {}"

#: deptree_graph.cpp:452
#, c++-format
msgid "{} [expanded elsewhere]"
msgstr "{} [розгорнуто в іншому місці]"
