#: deptree.cpp:31
msgid "Display package dependency trees."
msgstr "Rādīt pakotņu atkarību kokus."

#: deptree.cpp:35
msgid "Package names, NEVRAs, or glob patterns."
msgstr "Pakotņu nosaukumi, NEVRA vai aizstājējzīmju šabloni."

#: deptree.cpp:45
msgid "Show packages requiring each package."
msgstr "Rādīt pakotnes, kurām nepieciešama katra pakotne."

#: deptree.cpp:47
msgid "Print a sorted, deduplicated package list."
msgstr "Drukāt sakārtotu pakotņu sarakstu bez dublikātiem."

#: deptree.cpp:49
msgid "Show requirement capability nodes."
msgstr "Rādīt prasību spēju mezglus."

#: deptree.cpp:52
msgid "Include all matching package versions."
msgstr "Iekļaut visas atbilstošās pakotņu versijas."

#: deptree.cpp:54
msgid "Display dependency trees for installed packages only."
msgstr "Rādīt atkarību kokus tikai instalētajām pakotnēm."

#: deptree.cpp:59
msgid ""
"Show only branches leading to packages with specified names. List option, "
"supports globs."
msgstr ""
"Rādīt tikai zarus, kas ved uz pakotnēm ar norādītajiem nosaukumiem. Saraksta "
"opcija, atbalsta aizstājējzīmes."

#: deptree.cpp:64
msgid "Limit to packages of the specified architectures."
msgstr "Ierobežot ar norādīto arhitektūru pakotnēm."

#: deptree.cpp:78
msgid "Limit traversal to N dependency levels."
msgstr "Ierobežot pārlūkošanu ar N atkarību līmeņiem."

#: deptree.cpp:92
msgid ""
"Comma-separated dependency types: requires, recommends, suggests, "
"supplements, enhances."
msgstr ""
"Ar komatiem atdalīti atkarību tipi: requires, recommends, suggests, "
"supplements, enhances."

#: deptree.cpp:125
#, c++-format
msgid "No match for argument \"{}\"."
msgstr "Nav atbilsmes argumentam „{}”."

#: deptree_graph.cpp:422
#, c++-format
msgid "choice: {}"
msgstr "izvēle: {}"

#: deptree_graph.cpp:424
#, c++-format
msgid "if {}:"
msgstr "ja {}:"

#: deptree_graph.cpp:426
msgid "else:"
msgstr "citādi:"

#: deptree_graph.cpp:428
#, c++-format
msgid "requirement: {}"
msgstr "prasība: {}"

#: deptree_graph.cpp:430
#, c++-format
msgid "unsatisfied: {}"
msgstr "neapmierināta: {}"

#: deptree_graph.cpp:452
#, c++-format
msgid "{} [expanded elsewhere]"
msgstr "{} [izvērsts citur]"
