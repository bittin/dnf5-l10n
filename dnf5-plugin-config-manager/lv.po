msgstr "config-manager: pieprasīts noņemt neatbalstītu repozitorija opciju: {}"

#: unsetopt.cpp:106
#, c++-format
msgid "config-manager: Request to remove unsupported main option: {}"
msgstr "config-manager: pieprasīts noņemt neatbalstītu galveno opciju: {}"

