msgstr ""
"config-manager: pieprasīts noņemt galveno opciju, bet konfigurācijas failā "
"tās nav: {}"

#: unsetopt.cpp:152
#, c++-format
msgid ""
"config-manager: Request to remove main option but config file not found: {}"
msgstr ""
"config-manager: pieprasīts noņemt galveno opciju, bet konfigurācijas fails "
"nav atrasts: {}"

#: unsetopt.cpp:186
#, c++-format
msgid ""
"config-manager: Request to remove repository option but repoid is not "
"present in the overrides: {}"
msgstr ""
"config-manager: pieprasīts noņemt repozitorija opciju, bet pārrakstīšanas "
"iestatījumos nav šī repoid: {}"

#: unsetopt.cpp:194
#, c++-format
msgid ""
"config-manager: Request to remove repository option but it is not present in "
"the overrides: {}.{}"
msgstr ""
"config-manager: pieprasīts noņemt repozitorija opciju, bet pārrakstīšanas "
"iestatījumos tās nav: {}.{}"

#: unsetopt.cpp:208
#, c++-format
msgid ""
"config-manager: Request to remove repository option but file with overrides "
"not found: {}"
msgstr ""
"config-manager: pieprasīts noņemt repozitorija opciju, bet pārrakstīšanas "
"iestatījumu fails nav atrasts: {}"

#: unsetvar.cpp:69
#, c++-format
msgid ""
"config-manager: Request to remove variable but vars directory was not found: "
"{}"
msgstr ""
"config-manager: pieprasīts noņemt mainīgo, bet mainīgo direktorija nav "
"atrasta: {}"

#: unsetvar.cpp:82
#, c++-format
msgid ""
"config-manager: Request to remove variable but it is not present in the vars "
"directory: {}"
msgstr ""
"config-manager: pieprasīts noņemt mainīgo, bet mainīgo direktorijā tā nav: {}"

#: unsetvar.cpp:88
#, c++-format
msgid "Cannot remove variable file \"{}\": {}"
msgstr "Nevar noņemt mainīgā failu „{}”: {}"
