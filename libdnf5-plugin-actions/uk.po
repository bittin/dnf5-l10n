#: actions.cpp:239
#, c++-format
msgid "File \"{}\" on line {}: {}"
msgstr "Файл \"{}\", рядок {}: {}"

#: actions.cpp:627 actions.cpp:633 actions.cpp:639 actions.cpp:645
msgid "\"HOOK:PKG_FILTER:DIRECTION:OPTIONS:CMD\" format expected"
msgstr "очікується формат \"HOOK:PKG_FILTER:DIRECTION:OPTIONS:CMD\""

#: actions.cpp:667
#, c++-format
msgid "Unknown \"enabled\" option value \"{}\""
msgstr "Невідоме значення параметра \"enabled\": \"{}\""

#: actions.cpp:674
#, c++-format
msgid "Unknown option \"{}\""
msgstr "Невідомий параметр \"{}\""

#: actions.cpp:702
#, c++-format
msgid "Unknown hook \"{}\""
msgstr "Невідомий хук \"{}\""

#: actions.cpp:711
msgid ""
"Package filter can only be used in GOAL_RESOLVED, PRE_TRANS and POST_TRANS "
"hooks"
msgstr ""
"Фільтр пакунків можна використовувати лише в хуках GOAL_RESOLVED, PRE_TRANS "
"і POST_TRANS"

#: actions.cpp:717
msgid "Cannot use direction without package filter"
msgstr "Не можна використовувати напрямок без фільтра пакунків"

#: actions.cpp:731
#, c++-format
msgid "Unknown package direction \"{}\""
msgstr "Невідомий напрямок пакунків \"{}\""

#: actions.cpp:738
#, c++-format
msgid "Unknown mode \"{}\""
msgstr "Невідомий режим \"{}\""

#: actions.cpp:746
#, c++-format
msgid "Unsupported value of the \"raise_error\" option: {}"
msgstr "Непідтримуване значення параметра \"raise_error\": {}"

#: actions.cpp:751
msgid "Missing command"
msgstr "Відсутня команда"

#: actions.cpp:946
#, c++-format
msgid "Syntax error: Missing equal sign (=) in action output line: {}"
msgstr "Синтаксична помилка: у рядку виводу дії бракує знака рівності (=): {}"

#: actions.cpp:957
#, c++-format
msgid "Cannot set option: Action output line: {}"
msgstr "Не вдалося встановити параметр: рядок виводу дії: {}"

#: actions.cpp:975
#, c++-format
msgid "Action sent the wrong log level: {}"
msgstr "Дія надіслала неправильний рівень журналу: {}"

#: actions.cpp:980 actions.cpp:1792
#, c++-format
msgid "Action calls for stop: {}"
msgstr "Дія вимагає зупинки: {}"

#: actions.cpp:983 actions.cpp:1799
#, c++-format
msgid "Action sent error message: {}"
msgstr "Дія надіслала повідомлення про помилку: {}"

#: actions.cpp:988
#, c++-format
msgid ""
"Syntax error: Action output line must start with \"tmp.\" or \"conf.\" or "
"\"var.\" or \"stop=\" or \"error=\": {}"
msgstr ""
"Синтаксична помилка: рядок виводу дії має починатися з \"tmp.\", \"conf.\", "
"\"var.\", \"stop=\" або \"error=\": {}"

#: actions.cpp:1013
msgid "Error reading from action (from pipe)"
msgstr "Помилка читання від дії (з конвеєра)"

#: actions.cpp:1031
#, c++-format
msgid "Syntax error in json request from action: Missing starting '{{' char"
msgstr ""
"Синтаксична помилка в json-запиті від дії: бракує початкового символу '{{'"

#: actions.cpp:1055
msgid "Error during processing of a request from action."
msgstr "Помилка під час обробки запиту від дії."

#: actions.cpp:1064
#, c++-format
msgid "Syntax error in json request from action: {}"
msgstr "Синтаксична помилка в json-запиті від дії: {}"

#: actions.cpp:1072
msgid "Syntax error in json request from action: Incomplete input"
msgstr "Синтаксична помилка в json-запиті від дії: неповні вхідні дані"

#: actions.cpp:1147
msgid "Cannot write response"
msgstr "Не вдалося записати відповідь"

#: actions.cpp:1819
msgid "Actions plugin: Cannot create pipe"
msgstr "Плагін actions: не вдалося створити конвеєр"

#: actions.cpp:1911
msgid "Actions plugin: Cannot fork"
msgstr "Плагін actions: не вдалося виконати fork"

#: actions.cpp:1966
msgid "Actions plugin: Cannot bind command stdin"
msgstr "Плагін actions: не вдалося прив'язати stdin команди"

#: actions.cpp:1968
msgid "Actions plugin: Cannot bind command stdout"
msgstr "Плагін actions: не вдалося прив'язати stdout команди"

#: actions.cpp:1986
#, c++-format
msgid "Cannot execute action, command \"{}\" arguments \"{}\""
msgstr "Не вдалося виконати дію, команда \"{}\" аргументи \"{}\""

#: actions.cpp:1994
msgid "Error during preparation child process"
msgstr "Помилка під час підготовки дочірнього процесу"

#: actions.cpp:2013
#, c++-format
msgid "Exit code: {}"
msgstr "Код виходу: {}"

#: actions.cpp:2017
#, c++-format
msgid "Terminated by signal: {}"
msgstr "Завершено сигналом: {}"
