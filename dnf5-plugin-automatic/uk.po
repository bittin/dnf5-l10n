#: automatic.cpp:229
msgid ""
"An alternative CLI to 'dnf upgrade' suitable to be executed automatically "
"and regularly."
msgstr ""
"Альтернативний CLI до 'dnf upgrade', призначений для автоматичного й "
"регулярного запуску."

#: automatic.cpp:235
msgid "Apply random delay before execution."
msgstr "Застосувати випадкову затримку перед запуском."

#: automatic.cpp:240
msgid "Automatically download updated packages"
msgstr "Автоматично завантажувати оновлені пакунки"

#: automatic.cpp:247
msgid "Do not automatically download updated packages"
msgstr "Не завантажувати оновлені пакунки автоматично"

#: automatic.cpp:256
msgid "Automatically install downloaded updates"
msgstr "Автоматично встановлювати завантажені оновлення"

#: automatic.cpp:263
msgid "Do not automatically install downloaded updates"
msgstr "Не встановлювати завантажені оновлення автоматично"

#: automatic.cpp:316
#, c++-format
msgid ""
"Warning: Configuration file location \"{}\" for dnf automatic is deprecated. "
"See dnf5-automatic(8) for details."
msgstr ""
"Попередження: розташування файлу конфігурації \"{}\" для dnf automatic "
"застаріле. Докладніше див. dnf5-automatic(8)."

#: automatic.cpp:382
#, c++-format
msgid ""
"The \"email\" emitter is configured but the installed libcurl does not "
"support the {} protocol."
msgstr ""
"Налаштовано емітер \"email\", але встановлена libcurl не підтримує протокол "
"{}."

#: automatic.cpp:425
msgid "Resolved transaction:"
msgstr "Розв'язана транзакція:"

#: automatic.cpp:454
msgid "Downloading packages:"
msgstr "Завантаження пакунків:"

#: automatic.cpp:464
msgid "Packages downloaded."
msgstr "Пакунки завантажено."

#: automatic.cpp:467
msgid "Running transaction:"
msgstr "Виконання транзакції:"

#: automatic.cpp:481
msgid "Transaction finished."
msgstr "Транзакцію завершено."

#: automatic.cpp:483
msgid "Transaction failed: "
msgstr "Транзакція не вдалася: "

#: automatic.cpp:516
#, c++-format
msgid "Unknown report emitter for dnf5 automatic: \"{}\"."
msgstr "Невідомий емітер звітів для dnf5 automatic: \"{}\"."

#: automatic.cpp:531
#, c++-format
msgid "Error: reboot command returned nonzero exit code: {}"
msgstr "Помилка: команда перезавантаження повернула ненульовий код виходу: {}"

#: emitters.cpp:64
msgid "No new upgrades available."
msgstr "Нових оновлень немає."

#: emitters.cpp:68
#, c++-format
msgid "{} packages can be upgraded."
msgstr "Оновити можна {} пакунків."

#: emitters.cpp:71
#, c++-format
msgid "{} new upgrades have been downloaded."
msgstr "Завантажено нових оновлень: {}."

#: emitters.cpp:74
#, c++-format
msgid "{} new upgrades have been installed."
msgstr "Встановлено нових оновлень: {}."

#: emitters.cpp:82
msgid "Failed to check for upgrades."
msgstr "Не вдалося перевірити оновлення."

#: emitters.cpp:85
msgid "Failed to download upgrades."
msgstr "Не вдалося завантажити оновлення."

#: emitters.cpp:88
msgid "Failed to install upgrades."
msgstr "Не вдалося встановити оновлення."

#: emitters.cpp:143 emitters.cpp:164
#, c++-format
msgid "[{}] dnf5-automatic: {}"
msgstr "[{}] dnf5-automatic: {}"
