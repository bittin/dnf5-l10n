#: automatic.cpp:229
msgid ""
"An alternative CLI to 'dnf upgrade' suitable to be executed automatically "
"and regularly."
msgstr ""
"Alternatīva CLI komandai „dnf upgrade”, piemērota automātiskai un regulārai "
"izpildei."

#: automatic.cpp:235
msgid "Apply random delay before execution."
msgstr "Pirms izpildes ieturēt nejaušu aizturi."

#: automatic.cpp:240
msgid "Automatically download updated packages"
msgstr "Automātiski lejupielādēt atjauninātās pakotnes"

#: automatic.cpp:247
msgid "Do not automatically download updated packages"
msgstr "Automātiski nelejupielādēt atjauninātās pakotnes"

#: automatic.cpp:256
msgid "Automatically install downloaded updates"
msgstr "Automātiski instalēt lejupielādētos atjauninājumus"

#: automatic.cpp:263
msgid "Do not automatically install downloaded updates"
msgstr "Automātiski neinstalēt lejupielādētos atjauninājumus"

#: automatic.cpp:316
#, c++-format
msgid ""
"Warning: Configuration file location \"{}\" for dnf automatic is deprecated. "
"See dnf5-automatic(8) for details."
msgstr ""
"Brīdinājums: dnf automatic konfigurācijas faila atrašanās vieta „{}” ir "
"novecojusi. Sīkāku informāciju skatiet dnf5-automatic(8)."

#: automatic.cpp:382
#, c++-format
msgid ""
"The \"email\" emitter is configured but the installed libcurl does not "
"support the {} protocol."
msgstr ""
"Ir konfigurēts „email” izvadītājs, bet instalētā libcurl neatbalsta "
"protokolu {}."

#: automatic.cpp:425
msgid "Resolved transaction:"
msgstr "Atrisinātā transakcija:"

#: automatic.cpp:454
msgid "Downloading packages:"
msgstr "Lejupielādē pakotnes:"

#: automatic.cpp:464
msgid "Packages downloaded."
msgstr "Pakotnes lejupielādētas."

#: automatic.cpp:467
msgid "Running transaction:"
msgstr "Veic transakciju:"

#: automatic.cpp:481
msgid "Transaction finished."
msgstr "Transakcija pabeigta."

#: automatic.cpp:483
msgid "Transaction failed: "
msgstr "Transakcija neizdevās: "

#: automatic.cpp:516
#, c++-format
msgid "Unknown report emitter for dnf5 automatic: \"{}\"."
msgstr "Nezināms dnf5 automatic atskaišu izvadītājs: „{}”."

#: automatic.cpp:531
#, c++-format
msgid "Error: reboot command returned nonzero exit code: {}"
msgstr "Kļūda: pārstartēšanas komanda atgrieza izejas kodu, kas nav nulle: {}"

#: emitters.cpp:64
msgid "No new upgrades available."
msgstr "Nav pieejamu jaunu jauninājumu."

#: emitters.cpp:68
#, c++-format
msgid "{} packages can be upgraded."
msgstr "Jaunināmās pakotnes: {}."

#: emitters.cpp:71
#, c++-format
msgid "{} new upgrades have been downloaded."
msgstr "Lejupielādētie jaunie jauninājumi: {}."

#: emitters.cpp:74
#, c++-format
msgid "{} new upgrades have been installed."
msgstr "Instalētie jaunie jauninājumi: {}."

#: emitters.cpp:82
msgid "Failed to check for upgrades."
msgstr "Neizdevās pārbaudīt jauninājumus."

#: emitters.cpp:85
msgid "Failed to download upgrades."
msgstr "Neizdevās lejupielādēt jauninājumus."

#: emitters.cpp:88
msgid "Failed to install upgrades."
msgstr "Neizdevās instalēt jauninājumus."

#: emitters.cpp:143 emitters.cpp:164
#, c++-format
msgid "[{}] dnf5-automatic: {}"
msgstr "[{}] dnf5-automatic: {}"
