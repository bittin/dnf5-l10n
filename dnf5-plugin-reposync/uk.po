#: reposync.cpp:67
msgid "Synchronize a remote DNF repository to a local directory."
msgstr "Синхронізувати віддалений репозиторій DNF з локальним каталогом."

#: reposync.cpp:122
#, c++-format
msgid ""
"Invalid value \"{}\" for \"--latest-limit\", a positive integer is required"
msgstr ""
"Некоректне значення \"{}\" для \"--latest-limit\": потрібне додатне ціле "
"число"

#: reposync.cpp:191
msgid "Can't use --norepopath with multiple repositories enabled"
msgstr ""
"Не можна використовувати --norepopath, якщо увімкнено кілька репозиторіїв"

#: reposync.cpp:196
msgid "Can't use --safe-write-path with multiple repositories enabled"
msgstr ""
"Не можна використовувати --safe-write-path, якщо увімкнено кілька "
"репозиторіїв"

#: reposync.cpp:292
#, c++-format
msgid ""
"Download destination '{0}' for location '{1}' of '{2}' package from '{3}' "
"repo is outside of safe write path '{4}'."
msgstr ""
"Призначення завантаження '{0}' для розташування '{1}' пакунка '{2}' з "
"репозиторію '{3}' перебуває поза безпечним шляхом запису '{4}'."

#: reposync.cpp:320
#, c++-format
msgid "Failed to download package: {}"
msgstr "Не вдалося завантажити пакунок: {}"

#: reposync.cpp:323
msgid "Failed to download one or more packages"
msgstr "Не вдалося завантажити один або кілька пакунків"

#: reposync.cpp:335
#, c++-format
msgid "Failed to create directory '{0}' iterator: {1}"
msgstr "Не вдалося створити ітератор каталогу '{0}': {1}"

#: reposync.cpp:348
#, c++-format
msgid "Failed to delete file {0}: {1}"
msgstr "Не вдалося вилучити файл {0}: {1}"

#: reposync.cpp:351
#, c++-format
msgid "[DELETED] {}"
msgstr "[ВИЛУЧЕНО] {}"

#: reposync.cpp:367
#, c++-format
msgid "Removing '{}' with failing OpenPGP check: {}"
msgstr "Вилучення '{}' з невдалою перевіркою OpenPGP: {}"

#: reposync.cpp:430
msgid "Failed to get mirror for metadata."
msgstr "Не вдалося отримати дзеркало для метаданих."

#: reposync.cpp:440
#, c++-format
msgid "Failed to get mirror for package: \"{}\""
msgstr "Не вдалося отримати дзеркало для пакунка: \"{}\""

#: reposync.cpp:456
msgid "OpenPGP signature check failed"
msgstr "Перевірка підпису OpenPGP не вдалася"
