#: reposync.cpp:67
msgid "Synchronize a remote DNF repository to a local directory."
msgstr "Sinhronizēt attālu DNF repozitoriju ar lokālu direktoriju."

#: reposync.cpp:122
#, c++-format
msgid ""
"Invalid value \"{}\" for \"--latest-limit\", a positive integer is required"
msgstr ""
"Nederīga vērtība „{}” opcijai „--latest-limit”, nepieciešams pozitīvs vesels "
"skaitlis"

#: reposync.cpp:191
msgid "Can't use --norepopath with multiple repositories enabled"
msgstr "Opciju --norepopath nevar lietot, ja iespējoti vairāki repozitoriji"

#: reposync.cpp:196
msgid "Can't use --safe-write-path with multiple repositories enabled"
msgstr ""
"Opciju --safe-write-path nevar lietot, ja iespējoti vairāki repozitoriji"

#: reposync.cpp:292
#, c++-format
msgid ""
"Download destination '{0}' for location '{1}' of '{2}' package from '{3}' "
"repo is outside of safe write path '{4}'."
msgstr ""
"Lejupielādes mērķis „{0}” vietai „{1}” pakotnei „{2}” no repozitorija „{3}” "
"ir ārpus drošā rakstīšanas ceļa „{4}”."

#: reposync.cpp:320
#, c++-format
msgid "Failed to download package: {}"
msgstr "Neizdevās lejupielādēt pakotni: {}"

#: reposync.cpp:323
msgid "Failed to download one or more packages"
msgstr "Neizdevās lejupielādēt vienu vai vairākas pakotnes"

#: reposync.cpp:335
#, c++-format
msgid "Failed to create directory '{0}' iterator: {1}"
msgstr "Neizdevās izveidot direktorijas „{0}” iteratoru: {1}"

#: reposync.cpp:348
#, c++-format
msgid "Failed to delete file {0}: {1}"
msgstr "Neizdevās dzēst failu {0}: {1}"

#: reposync.cpp:351
#, c++-format
msgid "[DELETED] {}"
msgstr "[IZDZĒSTS] {}"

#: reposync.cpp:367
#, c++-format
msgid "Removing '{}' with failing OpenPGP check: {}"
msgstr "Noņem „{}”, kam neizdevās OpenPGP pārbaude: {}"

#: reposync.cpp:430
msgid "Failed to get mirror for metadata."
msgstr "Neizdevās iegūt metadatu spoguļserveri."

#: reposync.cpp:440
#, c++-format
msgid "Failed to get mirror for package: \"{}\""
msgstr "Neizdevās iegūt spoguļserveri pakotnei: „{}”"

#: reposync.cpp:456
msgid "OpenPGP signature check failed"
msgstr "OpenPGP paraksta pārbaude neizdevās"
